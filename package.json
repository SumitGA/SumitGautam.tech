    "react": "^16.8.0",
    "react-bootstrap": "^1.4.3",
    "react-cursor-custom": "^1.2.4",
    "react-dom": "^16.8.0",
    "react-ga": "^3.3.0",
    "react-icons": "^4.2.0",
    "react-is": "^17.0.1",
    "react-reveal": "^1.2.2",
    "react-rounded-image": "^2.0.11",
