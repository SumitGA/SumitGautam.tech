# Copy this to .env.local and fill in your Supabase project credentials.
# Find these in: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# For the admin panel (used server-side only — never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Contact form — get your API key at resend.com/api-keys
RESEND_API_KEY=
# Optional: override the "from" address (must be from a Resend-verified domain)
# RESEND_FROM_EMAIL=Portfolio Contact <noreply@sumitgautam.tech>
# Optional: override the recipient address (defaults to sumitga@sumitgautam.tech)
# CONTACT_TO_EMAIL=sumitga@sumitgautam.tech

# AI chatbot — free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.1-flash-lite)
# Flash-Lite is the default deliberately — full Flash models cap at 20 requests
# per day on the free tier. See CLAUDE.md before changing this.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: rate limit — messages per IP per window (defaults: 15 per hour)
# CHAT_RATE_LIMIT=15
# CHAT_RATE_WINDOW_SECONDS=3600
# Shared secret for on-demand cache invalidation. The admin panel sends this
# when content changes so edits appear immediately instead of waiting for the
# revalidate window. Must match REVALIDATE_SECRET in the admin project.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Optional: contact form rate limit (defaults: 3 per hour per IP)
# CONTACT_RATE_LIMIT=3
# CONTACT_RATE_WINDOW_SECONDS=3600
