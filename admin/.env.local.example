# Copy to .env.local — use the SAME Supabase project as the portfolio

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key allows bypassing RLS — keep this server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Must match REVALIDATE_SECRET in the portfolio project. Without it saves still
# work — the site just waits for its own revalidate window instead of updating
# immediately.
REVALIDATE_SECRET=

# The site to invalidate. Defaults to https://sumitgautam.tech; point it at
# http://localhost:3000 when running both locally.
# PORTFOLIO_URL=https://sumitgautam.tech

# Cloudinary. The admin uploads images, so it needs credentials as well as the
# cloud name.
#
# NEVER prefix the secret with NEXT_PUBLIC_ — that inlines it into the
# JavaScript sent to the browser, where anyone can read it. Uploads are signed
# server-side and the browser only ever receives the signature.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
