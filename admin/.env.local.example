# Copy to .env.local — use the SAME Supabase project as the portfolio

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key allows bypassing RLS — keep this server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Must match REVALIDATE_SECRET in the portfolio project. Without it saves still
# work — the site just waits for its own revalidate window instead of updating
# immediately.
REVALIDATE_SECRET=

# The site to invalidate. Defaults to https://sumitgautam.tech; point it at
# http://localhost:3000 when running both locally.
# PORTFOLIO_URL=https://sumitgautam.tech
